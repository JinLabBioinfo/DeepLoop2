def build_eval_loader(rep_names, eval_chroms, matrix_size, step_size):
    eval_datasets = []
    for chrom in eval_chroms:
        cool_files = [f'/home/kxt439/DeepLoop2.0/rep_coolers/chroms/{chrom}/{chrom}_{rep}.npz' for rep in rep_names]
        target_file = f'/home/kxt439/DeepLoop2.0/rep_coolers/target_chroms/combined/{chrom}_reproducible_combined.npz'
        if all(os.path.exists(f) for f in cool_files + [target_file]):
            eval_data = MatrixDataset(
                cool_files, target_file,
                matrix_size=matrix_size, step_size=step_size,
                log_transform=True,
                jitter=False, symmetric=True
            )
            eval_datasets.append(eval_data)
    eval_loader = DataLoader(
        torch.utils.data.ConcatDataset(eval_datasets) if len(eval_datasets) > 0 else [],
        batch_size=batch_size,
        shuffle=False,
        num_workers=2,
        pin_memory=False
    )
    return eval_loader

def parse_args():
    ap = argparse.ArgumentParser(description="Train VQ-UNet on Hi-C with optional resume from old DeepLoop checkpoint.")
    ap.add_argument("--resume-onnx", type=str, default=None, help="Path to old ONNX (converted from TF).")
    ap.add_argument("--resume-pth",  type=str, default=None, help="Path to .pth weights corresponding to the ONNX (or raw PyTorch state dict).")
    ap.add_argument("--viz-dir", type=str, default="viz", help="Directory to save visualizations/checkpoints.")
    ap.add_argument("--train-iters", type=int, default=train_iter, help="Total training iterations.")
    ap.add_argument("--lr", type=float, default=lr, help="Learning rate.")
    ap.add_argument("--start-step", type=int, default=0, help="Global step offset if resuming.")
    return ap.parse_args()

if __name__ == '__main__':
    torch.manual_seed(seed)
    args = parse_args()
    wandb.init(project="hic_vqvae")

    rep_names = [
        'H9', 'H7', 'HUES1', 'HUES2', 'HUES4', 'HUES8', 'ESI051', 'ESI035', 'ESI017',
        '51213', '51339', 'ACS_1011', 'ACS_1019', 'ACS_1026', 'AG28869', 'CJ-IPS',
        'H1', '51286', 'AG28041', 'DIS1016', 'GM23716', 'GM23720',
        'iPSC_075C', 'iPSC_088B', 'iPSC_1029C', 'iPSC_1106'
    ]
    train_chroms = [f'chr{i}' for i in range(1, 23, 2)]  # odd
    eval_chroms  = [f'chr{i}' for i in range(2, 23, 2)]  # even

    # Build evaluation loader once
    eval_loader = build_eval_loader(rep_names, eval_chroms, matrix_size, step_size)

    # Build your current PyTorch model
    model = UNet(
        n_channels=1, n_classes=1, init_filters=64,
        bilinear=True,
        codebook_size=num_codes,
        rotation_trick=rotation_trick,
        straight_through=False
    ).to(device)

    print('Device:', device)
    print(f"Number of parameters: {sum(p.numel() for p in model.parameters())}")

    # ---- Resume weights from old checkpoint (if provided) ----
    resume_from_old_checkpoint(
        dst_model=model,
        onnx_path=args.resume_onnx,
        pth_path=args.resume_pth,
        map_location='cpu'
    )

    # ---- Train chromosome-by-chromosome ----
    print("Starting chromosome-wise training...")
    chrom_count = 0
    total_iters = int(args.train_iters)
    iters_per_chrom = max(1, total_iters // len(train_chroms))
    start_step = int(args.start_step)

    for chrom in train_chroms:
        cool_files = [f'/home/kxt439/DeepLoop2.0/rep_coolers/chroms/{chrom}/{chrom}_{rep}.npz' for rep in rep_names]
        target_file = f'/home/kxt439/DeepLoop2.0/rep_coolers/target_chroms/combined/{chrom}_reproducible_combined.npz'

        if not all(os.path.exists(f) for f in cool_files + [target_file]):
            print(f"[Skipping] {chrom} due to missing files")
            continue

        print(f"[Loading] {chrom} for training...")
        dataset = MatrixDataset(
            cool_files, target_file,
            matrix_size=matrix_size, step_size=step_size,
            log_transform=True
        )
        train_loader = DataLoader(
            dataset,
            batch_size=batch_size,
            shuffle=True,
            num_workers=2,
            pin_memory=False
        )

        start_step = train(
            model,
            train_loader,
            eval_loader,
            train_iterations=iters_per_chrom,
            lr=args.lr,
            viz_dir=args.viz_dir,
            start_step=start_step
        )
        chrom_count += 1

    print(f"Finished training on {chrom_count} chromosomes.")

    # Optional: final quick viz on the last train_loader batch
    try:
        x, y = next(iter(train_loader))
        rep = x[:, 0].unsqueeze(1).to(device)
        out, _, _ = model(rep)
        x = np.expm1(rep.detach().cpu().numpy())
        out = np.expm1(out.detach().cpu().numpy())
        y = np.expm1(y.detach().cpu().numpy())
        for i in range(min(4, x.shape[0])):
            fig, axs = plt.subplots(1, 3, figsize=(6, 2))
            axs[0].imshow(x[i, 0], cmap="Reds"); axs[0].set_title("Input")
            axs[1].imshow(out[i, 0], cmap="Reds"); axs[1].set_title("Reconstruction")
            axs[2].imshow(y[i], cmap="Reds"); axs[2].set_title("Target")
            plt.tight_layout()
            plt.savefig(f'{args.viz_dir}/vqae_train_post_{i}.png')
            plt.close()
    except Exception as e:
        print(f"[PostViz] Skipped final viz due to: {e}")
