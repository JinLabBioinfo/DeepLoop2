def train(model, train_loader, eval_loader, train_iterations=1000, lr=1e-4, alpha=10, viz_dir="viz", start_step=0):
    opt = torch.optim.AdamW(model.parameters(), lr=lr)
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer=opt, lr_lambda=wsd_lambda)

    os.makedirs(viz_dir, exist_ok=True)
    os.makedirs(os.path.join(viz_dir, "heatmaps"), exist_ok=True)
    os.makedirs(os.path.join(viz_dir, "filters"), exist_ok=True)

    def iterate_dataset(data_loader):
        data_iter = iter(data_loader)
        while True:
            try:
                x, y = next(data_iter)
            except StopIteration:
                data_iter = iter(data_loader)
                x, y = next(data_iter)
            yield x.to(device), y.to(device)

    # viz_x, viz_y = next(iterate_dataset(eval_loader))
    print("[Debug] Checking eval_loader...")
    if not hasattr(eval_loader, "dataset"):
        print("[Debug] eval_loader has no dataset attribute!")
    elif len(eval_loader.dataset) == 0:
        print("[Debug] eval_loader dataset is empty!")
        viz_source = train_loader
    else:
        print(f"[Debug] eval_loader dataset size: {len(eval_loader.dataset)}")
        viz_source = eval_loader

    print("[Debug] Trying to fetch first batch for visualization...")
    viz_x, viz_y = next(iterate_dataset(viz_source))
    print(f"[Debug] viz_x shape: {viz_x.shape}, viz_y shape: {viz_y.shape}")
    print("[Debug] got first batch for visualization.")


    global global_step
    global_step = start_step

    pbar = trange(train_iterations)
    for _ in pbar:
        x, y = next(iterate_dataset(train_loader))
        opt.zero_grad()

        preds, indices, cmt_loss = model(x.view(-1, 1, matrix_size, matrix_size))  # model returns (preds, indices, commit_loss)

        # --- VQ codebook perplexity ---
        flat_idx = indices.view(-1)
        counts = torch.bincount(flat_idx, minlength=num_codes).float()
        probs = counts / counts.sum().clamp_min(1.0)
        perplexity = torch.exp(-torch.sum(probs * torch.log(probs + 1e-10)))

        preds = preds.view(x.shape)         # [B, R, 1, H, W] → [B, R, 1, H, W]
        rep_target = y.unsqueeze(1)         # [B, 1, H, W] -> [B, 1, 1, H, W] (broadcastable)

        # reconstruction + replicate consistency
        rec_loss = 0.0
        rep_loss = 0.0
        for rep_i in range(x.shape[1]):
            out = preds[:, rep_i].unsqueeze(1)  # [B, 1, H, W]
            rec_loss = rec_loss + (out - rep_target).abs().mean()
            for rep_j in range(x.shape[1]):
                if rep_i != rep_j:
                    rep2_target = preds[:, rep_j].unsqueeze(1)
                    rep_loss = rep_loss + torch.nn.functional.mse_loss(out, rep2_target)

        nrep = max(1, x.shape[1])
        rec_loss = rec_loss / nrep
        if nrep > 1:
            rep_loss = rep_loss / (nrep * (nrep - 1))
        else:
            rep_loss = torch.zeros((), device=preds.device)

        loss = rec_loss + 0.1 * rep_loss + 10.0 * cmt_loss
        loss.backward()
        opt.step()

        wandb.log({
            "loss/rec": float(rec_loss.detach().cpu()),
            "loss/rep": float(rep_loss.detach().cpu()),
            "loss/commit": float(cmt_loss.detach().cpu()),
            "vqvae/perplexity": float(perplexity.detach().cpu()),
            "lr": scheduler.get_last_lr()[0]
        }, step=global_step)

        pbar.set_description(f"rec {rec_loss.item():.3f} | rep {rep_loss.item():.3f} | cmt {cmt_loss.item():.3f}")

        if global_step % 1000 == 0:
            with torch.no_grad():
                rep = viz_x[:, 0].unsqueeze(1).to(device)  # use the first replicate for viz
                out, _, _ = model(rep)
                x_in = rep.detach().cpu().numpy()
                out = out.detach().cpu().numpy()
                y_np = viz_y.detach().cpu().numpy()

                # undo log1p
                x_in = np.expm1(x_in)
                out = np.expm1(out)
                y_np = np.expm1(y_np)

                # metrics
                B = out.shape[0]
                ssim_vals, strat_corr_vals = [], []
                for b in range(B):
                    pred_mat = out[b, 0]
                    true_mat = y_np[b]
                    s = ssim(pred_mat, true_mat, data_range=true_mat.max() - true_mat.min() if true_mat.max() > true_mat.min() else 1.0)
                    ssim_vals.append(s)
                    strat_corr_vals.append(stratified_corr(pred_mat, true_mat))
                wandb.log({
                    "viz/ssim": float(np.mean(ssim_vals)),
                    "viz/stratified_corr": float(np.mean(strat_corr_vals)),
                }, step=global_step)

                # heatmaps
                n = min(8, x_in.shape[0])
                fig, axs = plt.subplots(n, 5, figsize=(8, 2*n))
                for i in range(n):
                    axs[i][0].imshow(x_in[i, 0], cmap="Reds", vmin=1, vmax=2, interpolation=None)
                    axs[i][0].set_xticks([]); axs[i][0].set_yticks([])
                    pred = out[i, 0]
                    pred = (pred + pred.T) / 2
                    axs[i][1].imshow(pred, cmap="Reds", vmin=1, vmax=2, interpolation=None)
                    axs[i][1].set_xticks([]); axs[i][1].set_yticks([])
                    axs[i][2].imshow(pred, cmap="Reds", interpolation=None)
                    axs[i][2].set_xticks([]); axs[i][2].set_yticks([])
                    axs[i][3].imshow(y_np[i], cmap="Reds", interpolation=None)
                    axs[i][3].set_xticks([]); axs[i][3].set_yticks([])
                    axs[i][4].imshow(y_np[i], cmap="Reds", vmin=1, vmax=2, interpolation=None)
                    axs[i][4].set_xticks([]); axs[i][4].set_yticks([])
                plt.tight_layout()
                plt.savefig(f'{viz_dir}/heatmaps/vqae_train_{global_step // 100}.png')
                plt.close()

                # visualize first conv filters
                first_weight = None
                for p in model.parameters():
                    first_weight = p.detach().cpu().numpy()
                    break
                if first_weight is not None and first_weight.ndim >= 2:
                    n_filters = getattr(model, "init_filters", first_weight.shape[0])
                    n_rows = int(math.sqrt(n_filters))
                    n_cols = math.ceil(n_filters / max(1, n_rows))
                    fig, axs = plt.subplots(n_rows, n_cols, figsize=(n_cols, n_rows))
                    for i in range(min(n_filters, n_rows * n_cols)):
                        sl = first_weight[i, 0] if first_weight.ndim >= 4 else first_weight
                        axs[i // n_cols, i % n_cols].imshow(sl, cmap="RdGy_r")
                        axs[i // n_cols, i % n_cols].set_xticks([]); axs[i // n_cols, i % n_cols].set_yticks([])
                    plt.tight_layout()
                    plt.savefig(f'{viz_dir}/filters/vqae_train_{global_step // 100}.png')
                    plt.close()

                wandb.log({"reconstruction": wandb.Image(f'{viz_dir}/heatmaps/vqae_train_{global_step // 100}.png')}, step=global_step)

            # Save lightweight weights
            torch.save(model.state_dict(), f'{viz_dir}/vqae_train_resume_combined.pt')

        scheduler.step()
        global_step += 1

    return global_step

