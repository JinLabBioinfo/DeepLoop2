def stratified_corr(pred: np.ndarray, true: np.ndarray) -> float:
    H = pred.shape[0]
    corrs = []
    for d in range(H):
        mask = np.eye(H, k=d, dtype=bool)
        p = pred[mask]
        t = true[mask]
        if p.size:
            corrs.append(np.corrcoef(p, t)[0, 1])
    return float(np.nanmean(corrs))

def create_wsd_lambda(warmup_steps, stable_steps, decay_steps, min_lr_ratio=0.001, decay_type='cosine'):
    def lr_lambda(current_step):
        if current_step < warmup_steps:
            return current_step / max(1, warmup_steps)
        elif current_step < warmup_steps + stable_steps:
            return 1.0
        else:
            decay_step = current_step - warmup_steps - stable_steps
            if decay_type == 'exponential':
                decay_rate = min_lr_ratio ** (1 / max(1, decay_steps))
                return max(decay_rate ** decay_step, min_lr_ratio)
            elif decay_type == 'cosine':
                progress = min(decay_step / max(1, decay_steps), 1.0)
                return max(min_lr_ratio + (1 - min_lr_ratio) * 0.5 * (1 + math.cos(math.pi * progress)), min_lr_ratio)
            else:
                raise ValueError(f"Unknown decay_type: {decay_type}")
    return lr_lambda

wsd_lambda = create_wsd_lambda(
    warmup_steps=1000,
    stable_steps=100000,
    decay_steps=20000,
    min_lr_ratio=0.001,
    decay_type='cosine'
)

def _fix_onnx_same_padding(onnx_model):
    """Replace auto_pad=SAME_UPPER with explicit pads based on kernel_shape."""
    from onnx import helper
    for node in onnx_model.graph.node:
        if node.op_type == 'Conv':
            # find auto_pad
            found_same = False
            for i, attr in enumerate(list(node.attribute)):
                if attr.name == 'auto_pad' and attr.s == b'SAME_UPPER':
                    # delete it
                    del node.attribute[i]
                    found_same = True
                    break
            if not found_same:
                continue
            # get kernel shape
            kshape = None
            for attr in node.attribute:
                if attr.name == 'kernel_shape':
                    kshape = list(attr.ints)
                    break
            if kshape:
                pads = []
                for k in kshape:
                    p = k // 2
                    pads.extend([p, p])  # both sides
                # Conv expects pads for spatial dims only (H,W) → [pad_top, pad_left, pad_bottom, pad_right] in ONNX
                # If 2D conv, we already provided [H_left, W_left, H_right, W_right]; ONNX order is [x1_begin, x2_begin, ..., x1_end, x2_end, ...]
                # For safety, if length==2 (kshape like [3,3]), we convert to 4 pads:
                if len(pads) == 2:
                    pads = [pads[0], pads[1], pads[0], pads[1]]
                node.attribute.append(helper.make_attribute('pads', pads))
    return onnx_model

def _copy_matching_params(src_state, dst_model, verbose=True):
    """
    Copy overlapping tensors (by key + shape) from src_state (state_dict-like)
    to dst_model. Falls back to shape-only matching if names differ.
    Returns counts and a brief report.
    """
    dst_state = dst_model.state_dict()
    used_src_keys = set()
    copied = 0
    name_matched = 0
    shape_matched = 0

    # 1) exact name+shape match first
    for k, v in dst_state.items():
        if k in src_state and src_state[k].shape == v.shape:
            dst_state[k] = src_state[k]
            used_src_keys.add(k)
            copied += 1
            name_matched += 1

    # 2) fallback: shape-only match for remaining dst keys
    # build buckets by shape for available src tensors
    from collections import defaultdict
    src_by_shape = defaultdict(list)
    for k, v in src_state.items():
        if k not in used_src_keys:
            src_by_shape[tuple(v.shape)].append(k)

    for k, v in dst_state.items():
        if k in used_src_keys:
            continue
        shape = tuple(v.shape)
        if shape in src_by_shape and len(src_by_shape[shape]) > 0:
            src_k = src_by_shape[shape].pop(0)
            dst_state[k] = src_state[src_k]
            used_src_keys.add(src_k)
            copied += 1
            shape_matched += 1

    missing_in_src = [k for k in dst_state.keys() if k not in used_src_keys and (k not in src_state or src_state.get(k, None) is None)]
    unexpected_in_src = [k for k in src_state.keys() if k not in used_src_keys]

    dst_model.load_state_dict(dst_state, strict=False)

    if verbose:
        print(f"[Resume] Copied {copied} tensors "
              f"(name+shape: {name_matched}, shape-only: {shape_matched}).")
        if missing_in_src:
            print(f"[Resume] Missing in source (kept random init): {len(missing_in_src)}")
        if unexpected_in_src:
            print(f"[Resume] Unused source tensors: {len(unexpected_in_src)}")
    return {
        "copied_total": copied,
        "name_shape": name_matched,
        "shape_only": shape_matched,
        "missing_in_src": missing_in_src,
        "unused_src": unexpected_in_src
    }

def resume_from_old_checkpoint(dst_model, onnx_path=None, pth_path=None, map_location='cpu'):
    """
    If onnx_path is provided: build a PyTorch module from ONNX, fix SAME padding, then use .state_dict().
    If pth_path is also provided: load that .pth into the ONNX-converted module first.
    If only pth_path is provided: try to load the dict directly and copy overlapping keys by shape.
    """
    if onnx_path:
        onnx, helper, ConvertModel = _lazy_import_onnx_stack()
        print(f"[Resume] Loading ONNX from: {onnx_path}")
        onnx_model = onnx.load(onnx_path)
        onnx_model = _fix_onnx_same_padding(onnx_model)
        src_torch_module = ConvertModel(onnx_model)
        src_torch_module.eval()

        if pth_path:
            print(f"[Resume] Loading .pth weights into the ONNX-converted module: {pth_path}")
            src_sd = torch.load(pth_path, map_location=map_location)
            # Some checkpoints may be wrapped like {'state_dict': ...}
            if isinstance(src_sd, dict) and any(k.startswith('module.') for k in src_sd.keys()) is False and 'state_dict' in src_sd:
                src_sd = src_sd['state_dict']
            try:
                src_torch_module.load_state_dict(src_sd, strict=False)
            except Exception as e:
                warnings.warn(f"Strict load into ONNX-converted module failed ({e}); will copy by shape later.")
                src_torch_module.load_state_dict(src_sd, strict=False)

        # Copy from ONNX-converted module to your current UNet
        return _copy_matching_params(src_torch_module.state_dict(), dst_model, verbose=True)

    elif pth_path:
        print(f"[Resume] Loading raw .pth state dict: {pth_path}")
        src_sd = torch.load(pth_path, map_location=map_location)
        if isinstance(src_sd, dict) and 'state_dict' in src_sd:
            src_sd = src_sd['state_dict']
        return _copy_matching_params(src_sd, dst_model, verbose=True)

    else:
        print("[Resume] No ONNX or PTH provided; training from scratch.")
        return None

